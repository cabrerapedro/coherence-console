# Neon Postgres connection string. Server-side only.
DATABASE_URL=

# Vercel AI Gateway. The AI SDK v6 reads this env var by default and routes
# `generateObject({ model: 'anthropic/claude-haiku-4-5' })` through the gateway.
AI_GATEWAY_API_KEY=

# Single-shared-secret password gate (middleware.ts + /login + /api/auth).
# When set, every route except /login and /api/auth is gated behind a cookie
# whose value is sha256(ACCESS_PASSWORD). Leave empty to disable the gate
# during local development.
ACCESS_PASSWORD=
