# Neon Postgres connection string. Server-side only.
DATABASE_URL=

# Vercel AI Gateway. Used by lib/classifier.ts via createAnthropic({ baseURL, apiKey }).
# NOTE: verify whether your gateway endpoint expects /v1 in the base — test with a real
# call before assuming. Some routes do, some don't.
VERCEL_AI_GATEWAY_URL=
VERCEL_AI_GATEWAY_KEY=

# Simple password gate added at the end. Leave empty during development.
ACCESS_PASSWORD=
