{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cabrerapedro/coherence-console/blob/main/data/synthetic_actions.schema.json",
  "title": "Coherence Console — Synthetic Actions Dataset",
  "description": "Hand-designed dataset of agent actions for classification regression testing. Loaded by scripts/seed_eighty.ts; underscore-prefixed fields (e.g. _design_note) are stripped before insertion into agent_actions.",
  "type": "object",
  "required": ["metadata", "actions"],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["version", "created", "purpose", "distribution"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string" },
        "created": { "type": "string", "format": "date" },
        "purpose": { "type": "string" },
        "distribution": {
          "type": "object",
          "required": [
            "correct",
            "incorrect",
            "ambiguous",
            "policy_violation",
            "autonomy_violation"
          ],
          "additionalProperties": false,
          "properties": {
            "correct": { "type": "integer", "minimum": 0 },
            "incorrect": { "type": "integer", "minimum": 0 },
            "ambiguous": { "type": "integer", "minimum": 0 },
            "policy_violation": { "type": "integer", "minimum": 0 },
            "autonomy_violation": { "type": "integer", "minimum": 0 }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "agent_id",
          "timestamp",
          "input",
          "context",
          "output",
          "tool_calls",
          "autonomy_level"
        ],
        "additionalProperties": false,
        "properties": {
          "agent_id": { "type": "string", "minLength": 1 },
          "timestamp": { "type": "string", "format": "date-time" },
          "input": { "type": "string", "minLength": 1 },
          "context": { "type": ["string", "null"] },
          "output": { "type": "string", "minLength": 1 },
          "tool_calls": {
            "type": "array",
            "items": { "type": "string" }
          },
          "autonomy_level": { "type": "integer", "minimum": 1, "maximum": 4 }
        },
        "patternProperties": {
          "^_": {
            "description": "Underscore-prefixed fields are design-time annotations (e.g. _design_note). Stripped by the loader before DB insert."
          }
        }
      }
    }
  }
}
